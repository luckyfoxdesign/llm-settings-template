# Build static output for the local preview image.
FROM node:26-bookworm-slim AS build

ENV ASTRO_TELEMETRY_DISABLED=1
WORKDIR /app

COPY package*.json ./
RUN npm ci --ignore-scripts && chown -R node:node /app
COPY --chown=node:node . .
USER 1000:1000
RUN npm run build

# Local preview only. Production deploys static output to Vercel.
FROM node:26-bookworm-slim

ENV ASTRO_TELEMETRY_DISABLED=1
WORKDIR /app

COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build /app/package*.json ./
RUN npm ci --omit=dev --ignore-scripts && chown -R node:node /app

EXPOSE 3000
USER 1000:1000
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "3000"]
