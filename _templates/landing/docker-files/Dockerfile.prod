# Stage 1: Build stage
FROM node:20-bookworm-slim AS build

WORKDIR /app

# Copy package files for dependency install
COPY package*.json ./

RUN npm ci

COPY . .

# Build the static site
RUN npm run build

# Stage 2: Runtime (static site preview)
FROM node:20-bookworm-slim

WORKDIR /app

# Copy only necessary files
COPY --from=build /app/dist ./dist
COPY --from=build /app/package*.json ./

# Install production dependencies (though, для статического сайта они могут быть минимальны)
RUN npm ci --omit=dev

# Expose port
EXPOSE 3000

# Serve the static build via astro preview
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "3000"]
