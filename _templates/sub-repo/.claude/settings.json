{
  "permissions": {
    "allow": [
      "Read(**/.env.example)",
      "Edit(**/.env.example)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env[!.]*)",
      "Read(**/.env.)",
      "Read(**/.env.[!e]*)",
      "Read(**/.env.e)",
      "Read(**/.env.e[!x]*)",
      "Read(**/.env.ex)",
      "Read(**/.env.ex[!a]*)",
      "Read(**/.env.exa)",
      "Read(**/.env.exa[!m]*)",
      "Read(**/.env.exam)",
      "Read(**/.env.exam[!p]*)",
      "Read(**/.env.examp)",
      "Read(**/.env.examp[!l]*)",
      "Read(**/.env.exampl)",
      "Read(**/.env.exampl[!e]*)",
      "Read(**/.env.example?*)",
      "Read(**/.env.example/**)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.kube/**)",
      "Read(**/.gnupg/**)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/auth.json)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*oauth*token*)",
      "Read(**/*access*token*)",
      "Read(**/*refresh*token*)",
      "Read(**/*api*token*)",
      "Read(**/*session*token*)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(chmod 777*)",
      "Bash(sudo rm*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | bash*)"
    ]
  }
}
