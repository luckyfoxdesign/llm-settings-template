{
  "permissions": {
    "allow": [
      "Read(**/.env.example)",
      "Edit(**/.env.example)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(!**/.env.example)",
      "Read(**/.env.example/?*)",
      "Read(//**/.env)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.kube/**)",
      "Read(**/.gnupg/**)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/auth.json)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*oauth*token*)",
      "Read(**/*access*token*)",
      "Read(**/*refresh*token*)",
      "Read(**/*api*token*)",
      "Read(**/*session*token*)",
      "Read(//**/.ssh/**)",
      "Read(//**/.aws/**)",
      "Read(//**/.kube/**)",
      "Read(//**/.gnupg/**)",
      "Read(//**/.npmrc)",
      "Read(//**/.netrc)",
      "Read(//**/auth.json)",
      "Read(//**/*credential*)",
      "Read(//**/*secret*)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*oauth*token*)",
      "Read(//**/*access*token*)",
      "Read(//**/*refresh*token*)",
      "Read(//**/*api*token*)",
      "Read(//**/*session*token*)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(chmod 777*)",
      "Bash(sudo rm*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | bash*)",
      "Bash(rm -fr*)",
      "Bash(rm -r *)",
      "Bash(find * -delete*)",
      "Bash(git clean *)",
      "Bash(git push -f*)",
      "Bash(git branch -D*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | zsh*)",
      "Bash(bash <(curl*)",
      "Bash(wget * | sh*)",
      "Bash(docker system prune*)",
      "Bash(docker volume prune*)",
      "Bash(docker volume rm*)",
      "Bash(sudo -i*)",
      "Bash(sudo su*)",
      "Bash(chmod -R 777*)",
      "Bash(chmod 0777*)",
      "Bash(chmod a+rwx*)"
    ],
    "ask": [
      "Bash(ssh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/guard-bash.sh\" || exit 2"
          }
        ]
      }
    ]
  }
}
